{
  "name": "@stacknyu/stack-pi-plugins",
  "version": "0.2.0",
  "private": true,
  "description": "Stacknyu's Pi plugins: task planning and queues with pi-flow, shared verification with pi-check.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/stacknyu/stack-pi-plugins.git"
  },
  "homepage": "https://github.com/stacknyu/stack-pi-plugins#readme",
  "bugs": "https://github.com/stacknyu/stack-pi-plugins/issues",
  "keywords": ["pi-package", "pi", "extensions"],
  "engines": { "node": ">=22.19.0" },
  "packageManager": "pnpm@12.14.0",
  "pi": {
    "extensions": ["./packages/pi-flow/extension.ts", "./packages/pi-check/extension.ts"],
    "skills": ["./packages/pi-flow/skills", "./packages/pi-check/skills"]
  },
  "scripts": {
    "test": "node --test packages/*/*.test.mjs tests/*.test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "typebox": "1.3.27"
  }
}
