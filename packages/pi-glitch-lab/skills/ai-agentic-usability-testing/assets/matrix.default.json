    "explore-dashboard": {
      "title": "First look: land, look around, open each main area",
      "steps": [
        {
          "goto": "/"
        },
        {
          "expectNoText": "{{persona.mustNotSee}}"
        },
        {
          "screenshot": "landing"
        },
        {
          "click": "Chat",
          "optional": true
        },
        {
          "click": "Notes",
          "optional": true
        },
        {
          "click": "Research",
          "optional": true
        },
        {
          "click": "Dashboard",
          "optional": true
        },
        {
          "screenshot": "back-to-dashboard"
        }
      ]
    },
    "arjun-checklist": {
      "title": "Get the Germany MS checklist and save it",
      "steps": [
        {
          "goto": "/"
        },
        {
          "expectNoText": "{{persona.mustNotSee}}",
          "note": "replaced at runtime by the persona's mustNotSee list"
        },
        {
          "click": "Chat",
          "note": "replace with the real label/icon name of the chat entry point"
        },
        {
          "click": "New chat",
          "optional": true
        },
        {
          "fill": {
            "placeholder": "Ask",
            "value": "What all documents and exams do I need for MS in Computer Science in Germany? I am in final year B.Tech with 7.8 CGPA."
          }
        },
        {
          "press": "Enter"
        },
        {
          "measureResponse": {
            "selector": "[data-role=assistant], .assistant-message, [data-message-author=assistant]",
            "timeout": 90000
          },
          "note": "replace selector with the real assistant-message container"
        },
        {
          "click": "Save to notes",
          "note": "replace with the real save/add-to-notes control"
        },
        {
          "waitForText": "Saved",
          "optional": true
        },
        {
          "click": "Notes"
        },
        {
          "screenshot": "notes-after-save"
        }
      ]
    },
